# Server Configuration
PORT=5000

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/agriconnect

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Chapa Payment Gateway (Ethiopia)
CHAPA_SECRET_KEY=your-chapa-secret-key

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:8080

# ===========================================
# Email Configuration (Resend)
# ===========================================
# Sign up at https://resend.com
# Create an API key at https://resend.com/api-keys
# (Optional) Verify your domain at https://resend.com/domains

RESEND_API_KEY=re_xxxxxxxxxxxx

# For testing, use: onboarding@resend.dev
# For production, use your verified domain email
EMAIL_FROM=AgriConnect <onboarding@resend.dev>
